# Local Reels — configuration
# Copy to .env and adjust. All values can also be set as environment variables.

# Absolute path (or path relative to the project root) of the folder
# containing your video files. Can also be changed at runtime from the UI
# (Settings on the dashboard / empty-state panel) — the runtime value wins.
VIDEO_DIR=./videos

# SQLite database file (created automatically).
DB_PATH=./data/localreel.db

# Only used when starting via `python -m backend.app.main`.
HOST=127.0.0.1
PORT=8000
